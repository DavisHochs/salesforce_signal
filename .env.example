# Copy to .env and fill in locally. Never commit .env.
# Values below are placeholders only.

# --- Decision provider (ADR-001: TypeSafe direct API) ---
# One of: mock | jev
DECISION_PROVIDER=mock
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Pin a version; aliases like jev-latest move
JEV_MODEL=jev-1.14.0

# --- Salesforce (D0.1) ---
# Alias you used with `sf org login web --alias <alias>`
SF_TARGET_ORG=signal-dev

# --- Email (ADR-003: Mailpit only) ---
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025
MAIL_FROM=journeys@ridgeline-outfitters.test
MAIL_TEST_TO=seed-inbox@ridgeline-outfitters.test

# --- Reproducibility ---
RANDOM_SEED=42
