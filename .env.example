# Copy to .env and fill in locally. Never commit .env.
# Values below are placeholders only.

# --- Decision provider (R0.1 / ADR-001) ---
# One of: mock | jev   (jev is wired up once ADR-001 is accepted)
DECISION_PROVIDER=mock
JEV_API_KEY=
JEV_BASE_URL=
# Set if reaching Jev through Vercel AI Gateway instead of directly
AI_GATEWAY_API_KEY=

# --- Salesforce (D0.1) ---
# Alias you used with `sf org login web --alias <alias>`
SF_TARGET_ORG=signal-dev

# --- Email (R0.3 / ADR-003) ---
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025
MAIL_FROM=journeys@ridgeline-outfitters.test
MAIL_TEST_TO=seed-inbox@ridgeline-outfitters.test
# Chosen email service (filled after ADR-003)
EMAIL_SERVICE=
EMAIL_SERVICE_API_KEY=

# --- Reproducibility ---
RANDOM_SEED=42
